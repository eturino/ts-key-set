{
  "name": "@eturino/key-set",
  "version": "5.12.0",
  "description": " (TypeScript port of https://github.com/eturino/ruby_key_set) KeySet with 4 classes to represent concepts of All, None, Some, and AllExceptSome, the last 2 with a sorted uniq list of keys, and all with intersection calculations",
  "main": "build/main/index.js",
  "module": "build/module/index.js",
  "types": "build/main/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/module/index.d.ts",
        "default": "./build/module/index.js"
      },
      "require": {
        "types": "./build/main/index.d.ts",
        "default": "./build/main/index.js"
      }
    },
    "./schemas/v1/key-set.schema.json": "./schemas/v1/key-set.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "schemas",
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.spec.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "husky",
    "prepack": "run-s build",
    "clean": "trash build coverage",
    "build": "run-s clean && run-p build:main build:module",
    "build:main": "tsc -p tsconfig.build.json",
    "build:module": "run-s build:module:tsc build:module:pkg",
    "build:module:tsc": "tsc -p tsconfig.module.json",
    "build:module:pkg": "node -e \"require('node:fs').writeFileSync('build/module/package.json', JSON.stringify({ type: 'module' }))\"",
    "fix": "biome check --write --unsafe src",
    "type-check": "tsc --noEmit",
    "check": "run-s check:biome type-check",
    "check:biome": "biome check src",
    "check:cycles": "dpdm --no-tree --no-warning --exit-code circular:1 src/index.ts",
    "check:dead-code": "knip --no-config-hints",
    "test": "run-s build check:biome test:unit check:dead-code type-check",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "watch": "run-s clean build:main && run-p \"build:main -- -w\" test:unit:watch",
    "cov": "run-s build cov:html && open-cli coverage/index.html",
    "cov:html": "vitest run --coverage --coverage.reporter=html",
    "version": "commit-and-tag-version",
    "reset": "git clean -dfx -e .idea && git reset --hard && pnpm install",
    "lint-staged": "lint-staged",
    "prepare-release": "run-s reset test version",
    "commit": "git-cz"
  },
  "author": "Eduardo Turiño <eturino@eturino.com>",
  "repository": {
    "type": "github",
    "url": "https://github.com/eturino/ts-key-set"
  },
  "bugs": {
    "url": "https://github.com/eturino/ts-key-set/issues"
  },
  "homepage": "https://github.com/eturino/ts-key-set",
  "license": "MIT",
  "keywords": [
    "key-set",
    "sets",
    "groups"
  ],
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "commit-and-tag-version": "^13.1.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dpdm": "^4.3.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "open-cli": "^9.0.0",
    "trash-cli": "^7.2.0",
    "ts-enum-util": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write --unsafe"
    ]
  }
}
